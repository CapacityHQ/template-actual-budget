# Actual's sync server reads these when Capacity starts it (.capacity/dev.mjs
# loads this file, then runs the server). Every option is documented at
# https://actualbudget.org/docs/config/ and is set here as ACTUAL_<NAME>.

# The port the server listens on. The preview opens http://localhost:<port>.
ACTUAL_PORT=5006

# Budget files and the server's own database are written under
# packages/sync-server/user-files and packages/sync-server/server-files (both
# gitignored). ACTUAL_DATA_DIR moves them; a relative path is taken from the
# project root.

# Other options, each off until the leading # is removed:
# ACTUAL_LOGIN_METHOD=password
# ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20
